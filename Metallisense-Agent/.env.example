# console.groq.com -> API Keys
GROQ_API_KEY=your_groq_api_key

API_PORT=8001
# 127.0.0.1 keeps this service localhost-only; use 0.0.0.0 only if it's
# deliberately deployed behind a reverse proxy/firewall on a server
API_HOST=127.0.0.1

# development | production - controls whether raw exception details are
# included in error responses (never enable detail leakage in production)
ENVIRONMENT=development

# Comma-separated list of origins allowed to call this API with credentials
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
