NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string, with <PASSWORD> as a literal placeholder
# (DATABASE_PASSWORD below is substituted into it at runtime)
DATABASE=mongodb+srv://<username>:<PASSWORD>@<cluster-host>/MetalliSense?retryWrites=true&w=majority
DATABASE_LOCAL=mongodb://localhost:27017/MetalliSense
DATABASE_PASSWORD=your_mongodb_atlas_password

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_64_byte_hex_secret
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_IN=1

# AI Service Configuration
AI_SERVICE_INDIVIDUAL_URL=http://localhost:8001
AI_SERVICE_AGENT_URL=http://localhost:8001

# Comma-separated list of origins allowed to call this API with credentials
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google AI Studio (https://aistudio.google.com) - real Gemini keys start with "AIza"
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
# ElevenLabs dashboard -> Profile -> API Keys (scope to Text to Speech only)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Firebase Authentication Configuration
# Option 1: Path to service account JSON file (recommended for production)
# FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Option 2: Individual environment variables (easier for deployment)
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
