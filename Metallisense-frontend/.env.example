VITE_API_BASE_URL=http://localhost:3000/api/v2
VITE_API_TIMEOUT=30000
VITE_COPILOT_BASE_URL=http://localhost:8001

# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and config
# These are public client identifiers, not secrets - access is enforced by
# Firebase security rules, not by hiding this config
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
